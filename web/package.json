{
  "name": "tkd-poomsae-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integrated": "tsc --project tsconfig.integrated.json && playwright test --config=playwright.camera.config.ts",
    "test:components": "playwright test",
    "test:browser": "npm run test:integrated && npm run test:components"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.180.0",
    "jsdom": "^26.1.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "5.0.2"
  }
}
